# Copy to .env and fill in. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=3001

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Auth ---
# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Email of the first admin account. Register that address in the app, then run:
#   npm run db:promote -- you@example.com
ADMIN_EMAIL=

# --- Database ---
# Defaults to backend/fashionhub.db
# DB_PATH=./fashionhub.db

# --- Payments (Phase 4 — not wired up yet) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Misc ---
# Set to true to have Express also serve ../frontend/dist on the same origin
SERVE_STATIC=false

# --- First-run convenience ---------------------------------------------------
# Pending migrations are applied automatically on boot (default: true).
AUTO_MIGRATE=true
# Seed the demo catalogue when the products table is empty. Defaults to true
# outside production and false in production; set explicitly to override.
# AUTO_SEED=true

# Shared secret that lets you create further admin accounts from /admin.html.
# Leave it blank and admin sign-up closes once the first admin exists — new
# admins are then promoted from Dashboard → Team & access.
ADMIN_SETUP_KEY=
