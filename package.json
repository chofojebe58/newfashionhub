{
  "name": "fashionhub",
  "version": "1.0.0",
  "private": true,
  "description": "LUNORA \u2014 a fashion storefront. Express + SQLite API and a framework-free Vite/TypeScript frontend.",
  "type": "module",
  "scripts": {
    "setup": "npm install --prefix backend && npm install --prefix frontend && npm run db:setup",
    "dev": "node scripts/dev.mjs",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "start": "npm --prefix backend run start",
    "db:setup": "npm --prefix backend run db:setup",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed": "npm --prefix backend run db:seed",
    "db:promote": "npm --prefix backend run db:promote",
    "typecheck": "npm --prefix frontend exec tsc -- --noEmit -p tsconfig.json",
    "lint": "npm --prefix frontend run lint",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run test:unit",
    "test": "npm run test:unit && npm run test:api",
    "test:api": "npm --prefix backend run test",
    "test:unit": "npm --prefix frontend run test"
  },
  "engines": {
    "node": ">=20"
  }
}
